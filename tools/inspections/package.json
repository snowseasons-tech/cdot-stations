{
  "private": true,
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild entry.tsx --bundle --minify --format=iife --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=../../public/inspections.js",
    "build:css": "tailwindcss -c tailwind.config.cjs -i inspections.css -o ../../public/inspections.css --minify"
  },
  "dependencies": {
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "tailwindcss": "3.4.17"
  }
}
